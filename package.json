{
  "name": "anywhere-desktop",
  "version": "1.1.5",
  "description": "AI Anywhere Desktop",
  "main": "./out/main/index.js",
  "author": {
    "name": "Komorebi",
    "email": "BY2439213@buaa.edu.cn"
  },
  "companyName": "Komorebi",
  "homepage": "https://electron-vite.org",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir --publish never",
    "build:win": "pnpm run build && electron-builder --win nsis --publish never",
    "build:mac": "pnpm run build && electron-builder --mac zip --publish never",
    "build:linux": "pnpm run build && electron-builder --linux AppImage --publish never",
    "release:win": "pnpm run build && electron-builder --win nsis --publish always",
    "release:mac": "pnpm run build && electron-builder --mac zip --publish always",
    "release:linux": "pnpm run build && electron-builder --linux AppImage --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@langchain/core": "^1.1.39",
    "@langchain/langgraph": "^1.2.7",
    "@langchain/mcp-adapters": "1.0.0",
    "adm-zip": "0.5.16",
    "dompurify": "^3.3.3",
    "electron-updater": "^6.3.9",
    "lowdb": "^7.0.1",
    "marked": "^17.0.4",
    "openai": "6.18.0",
    "pinyin-pro": "^3.28.0",
    "webdav": "^5.9.0",
    "data-uri-to-buffer": "^4.0.1",
    "fetch-blob": "^3.2.0",
    "formdata-polyfill": "^4.0.10",
    "node-domexception": "^1.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "element-plus": "^2.13.5",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.38",
    "less": "^4.6.3",
    "mermaid": "^11.13.0",
    "prettier": "^3.7.4",
    "recorder-core": "^1.3.25011100",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-element-plus-x": "1.3.7",
    "vue-eslint-parser": "^10.2.0",
    "vue-i18n": "^11.3.0",
    "vuedraggable": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
